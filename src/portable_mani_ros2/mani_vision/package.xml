<?xml version="1.0"?>
<package format="3">
  <name>mani_vision</name>
  <version>0.1.0</version>
  <description>Course vision modules: find objects with depth, choose one target by rule or DeepSeek.</description>
  <maintainer email="hongjin@example.com">hongjin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mani_interfaces</depend>
  <depend>mani_perception</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
